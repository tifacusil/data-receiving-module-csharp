[Unit]
Description=Landslide Monitoring — Data Receiving Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=data-receiving
Group=data-receiving
WorkingDirectory=/opt/data-receiving
ExecStart=/opt/data-receiving/DataReceiving
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5

Environment=DOTNET_ENVIRONMENT=Production
Environment=RECEIVER__PORT=5000
Environment=RECEIVER__DLXPATH=/var/log/data-receiving/dlx
Environment=RECEIVER__OUTPUTMODE=rabbitmq

# Redis
Environment=RECEIVER__REDIS__CONNECTIONSTRING=<redis-host>:6379
Environment=RECEIVER__REDIS__BUFFERTLTHOURS=24
Environment=RECEIVER__REDIS__RETRYINTERVALSECONDS=30
Environment=RECEIVER__REDIS__RETRYMINAGEMINUTES=2

# RabbitMQ (password comes from secrets file)
Environment=RECEIVER__RABBITMQ__HOST=<rabbitmq-host>
Environment=RECEIVER__RABBITMQ__PORT=5672
Environment=RECEIVER__RABBITMQ__VIRTUALHOST=/
Environment=RECEIVER__RABBITMQ__USERNAME=data_receiving
Environment=RECEIVER__RABBITMQ__EXCHANGE=sensors.raw
Environment=RECEIVER__RABBITMQ__CONFIRMTIMEOUTSECONDS=5

# Password stored separately with strict permissions
EnvironmentFile=/etc/data-receiving/secrets

StandardOutput=journal
StandardError=journal
SyslogIdentifier=data-receiving
LimitNOFILE=65536
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
