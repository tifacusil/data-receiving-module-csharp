# Core settings
RECEIVER__PORT=5000
RECEIVER__DLXPATH=/opt/data-receiving/dlx
RECEIVER__OUTPUTMODE=rabbitmq
RECEIVER__OUTPUTFILEPATH=/opt/data-receiving/output

# Redis (Wave 1 server: 204.168.203.32)
# Include the password in the connection string:  host:port,password=<secret>
RECEIVER__REDIS__CONNECTIONSTRING=204.168.203.32:6379,password=<Redis password>
RECEIVER__REDIS__BUFFERTLTHOURS=24
RECEIVER__REDIS__RETRYINTERVALSECONDS=30
RECEIVER__REDIS__RETRYMINAGEMINUTES=2

# RabbitMQ (Wave 1 server: 204.168.203.32)
RECEIVER__RABBITMQ__HOST=204.168.203.32
RECEIVER__RABBITMQ__PORT=5672
RECEIVER__RABBITMQ__VIRTUALHOST=/
RECEIVER__RABBITMQ__USERNAME=data-receiver
RECEIVER__RABBITMQ__EXCHANGE=sensors.raw
RECEIVER__RABBITMQ__CONFIRMTIMEOUTSECONDS=5
# Password goes in /etc/data-receiving/secrets — NOT here

# Consul (Wave 1 server: 204.168.203.32)
RECEIVER__CONSUL__ADDRESS=http://204.168.203.32:8500
RECEIVER__CONSUL__INSTANCEID=data-receiving-01
RECEIVER__CONSUL__HEALTHPORT=8080
RECEIVER__CONSUL__SERVICEVERSION=1.0.0
RECEIVER__CONSUL__ENVIRONMENT=prod
# Token goes in /etc/data-receiving/secrets — NOT here
